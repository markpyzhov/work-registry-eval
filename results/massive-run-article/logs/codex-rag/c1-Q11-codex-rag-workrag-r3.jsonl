 impact site it polici common block execut of unsign smartscreen flag binari outright which would prevent instal on target deploy workstat without a manual secur polici overrid root caus no code sign certif ha been procur or configur in the window build pipelin yet sourc id src gdoc 39 compat audit window build sign gap owner evan document key doc 2039 last updat 2026 09 02 path to resolut procur a code sign certif and wire sign into the releas build step is the onli remain item befor this clear the t029 window compat gate and by extens the t011 releas checklist which is hold on this exact sign gap alongsid the t005 imag slim down audit status activ build produc success sign certif procur is the sole open blocker\", \"dataset_id\": \"918880948a9911f197db2303d7337e37\", \"doc_type_kwd\": \"text\", \"document_id\": \"ee9526168a9911f197db2303d7337e37\", \"document_keyword\": \"med-synth/documentation/sources/2026-09-02-Windows-Compatibility-Audit-Report.md\", \"id\": \"3a7b937808b6fadd\", \"image_id\": \"\", \"important_keywords\": [], \"mom_id\": \"\", \"positions\": [], \"row_id\": null, \"similarity\": 0.4820533228890922, \"tag_kwd\": [], \"term_similarity\": 0.3442448184129889, \"vector_similarity\": 0.8036065, \"dataset_name\": \"C1WR-2\", \"document_name\": \"med-synth/documentation/sources/2026-09-02-Windows-Compatibility-Audit-Report.md\", \"document_metadata\": {\"document_id\": \"ee9526168a9911f197db2303d7337e37\", \"name\": \"med-synth/documentation/sources/2026-09-02-Windows-Compatibility-Audit-Report.md\", \"location\": \"med-synth/documentation/sources/2026-09-02-Windows-Compatibility-Audit-Report.md\", \"type\": \"doc\", \"size\": 1340, \"chunk_count\": 1, \"create_date\": \"2026-07-28T23:35:16\", \"update_date\": \"2026-07-31T20:06:00\", \"token_count\": 387, \"thumbnail\": \"\", \"dataset_id\": \"918880948a9911f197db2303d7337e37\", \"meta_fields\": {\"path\": \"sources\"}}}, {\"content\": \"**Source ID**: SRC-SLACK-37\\n\\n# Slack Thread: Windows Signi