td style text align left t002 td td style text align left financi regex detect td td style text align left complet 2026 06 08 td tr tr td style text align left t003 td td style text align left batch cli td td style text align left complet 2026 06 12 td tr tr td style text align left t004 td td style text align left rest api endpoint td td style text align left complet 2026 06 17 td tr tr td style text align left t005 td td style text align left docker packag td td style text align left strong activ reopen strong reopen 2026 06 25 on imag size cve review not yet met td tr tr td style text align left t006 td td style text align left redact polici config td td style text align left complet 2026 06 22 td tr tr td style text align left t010 td td style text align left secur audit td td style text align left complet 2026 07 10 td tr tbodi tabl\", \"dataset_id\": \"d13efb7c8a9a11f197db2303d7337e37\", \"doc_type_kwd\": \"table\", \"document_id\": \"e9b23eee8a9a11f197db2303d7337e37\", \"document_keyword\": \"med-synth/documentation/sources/2026-07-12-Release-Checklist.md\", \"id\": \"f6b236e144e5939b\", \"image_id\": \"\", \"important_keywords\": [], \"mom_id\": \"\", \"positions\": [], \"row_id\": null, \"similarity\": 0.301816308990199, \"tag_kwd\": [], \"term_similarity\": 0.11749305570028432, \"vector_similarity\": 0.7319039, \"dataset_name\": \"C1Raw-2\", \"document_name\": \"med-synth/documentation/sources/2026-07-12-Release-Checklist.md\", \"document_metadata\": {\"document_id\": \"e9b23eee8a9a11f197db2303d7337e37\", \"name\": \"med-synth/documentation/sources/2026-07-12-Release-Checklist.md\", \"location\": \"med-synth/documentation/sources/2026-07-12-Release-Checklist.md\", \"type\": \"doc\", \"size\": 1077, \"chunk_count\": 2, \"create_date\": \"2026-07-28T23:42:17\", \"update_date\": \"2026-07-31T20:01:40\", \"token_count\": 704, \"thumbnail\": \"\", \"dataset_id\": \"d13efb7c8a9a11f197db2303d7337e37\", \"meta_fields\": {\"path\": \"sources\"}}}, {\"content\": \"*