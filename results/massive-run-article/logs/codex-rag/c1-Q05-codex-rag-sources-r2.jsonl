at s clear alic okay charli keep push on the parser altern that s the prioriti evan keep chase procur on the cert but no need for a deep dive there today\", \"dataset_id\": \"d13efb7c8a9a11f197db2303d7337e37\", \"doc_type_kwd\": \"text\", \"document_id\": \"e951fd048a9a11f197db2303d7337e37\", \"document_keyword\": \"med-synth/communication/sources/fireflies/2026-08-15-Windows-License-Sync.md\", \"id\": \"5bd1df00b489f9f3\", \"image_id\": \"\", \"important_keywords\": [], \"mom_id\": \"\", \"positions\": [], \"row_id\": null, \"similarity\": 0.35795496890767314, \"tag_kwd\": [], \"term_similarity\": 0.19051226986810452, \"vector_similarity\": 0.7486546, \"dataset_name\": \"C1Raw-2\", \"document_name\": \"med-synth/communication/sources/fireflies/2026-08-15-Windows-License-Sync.md\", \"document_metadata\": {\"document_id\": \"e951fd048a9a11f197db2303d7337e37\", \"name\": \"med-synth/communication/sources/fireflies/2026-08-15-Windows-License-Sync.md\", \"location\": \"med-synth/communication/sources/fireflies/2026-08-15-Windows-License-Sync.md\", \"type\": \"doc\", \"size\": 1335, \"chunk_count\": 1, \"create_date\": \"2026-07-28T23:42:16\", \"update_date\": \"2026-07-31T20:03:03\", \"token_count\": 372, \"thumbnail\": \"\", \"dataset_id\": \"d13efb7c8a9a11f197db2303d7337e37\", \"meta_fields\": {\"path\": \"sources\"}}}], \"pagination\": {\"page\": 1, \"page_size\": 10, \"total_chunks\": 70, \"total_pages\": 7}, \"query_info\": {\"question\": \"As of 2026-09-22 license compliance PDF parser swap license gate reopened discovery replacement criteria\", \"similarity_threshold\": 0.2, \"vector_weight\": 0.3, \"keyword_search\": false, \"dataset_count\": 1}}"}],"structured_content":null},"error":null,"status":"completed"}}
