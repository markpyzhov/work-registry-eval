eam wa search for an apach or mit licens altern that search had not conclud a of this write sourc id src gdoc 24 third parti licens inventori report owner diana document key doc 2024 last updat 2026 08 21 retrospect cover 2026 08 09 note status through 2026 08 15\", \"dataset_id\": \"918880948a9911f197db2303d7337e37\", \"doc_type_kwd\": \"text\", \"document_id\": \"ee935bb08a9911f197db2303d7337e37\", \"document_keyword\": \"med-synth/documentation/sources/2026-08-21-License-Compliance-Review-Review.md\", \"id\": \"36fdb209a7d39279\", \"image_id\": \"\", \"important_keywords\": [], \"mom_id\": \"\", \"positions\": [], \"row_id\": null, \"similarity\": 0.27726205764537026, \"tag_kwd\": [], \"term_similarity\": 0.10217305663624328, \"vector_similarity\": 0.68580306, \"dataset_name\": \"C1WR-2\", \"document_name\": \"med-synth/documentation/sources/2026-08-21-License-Compliance-Review-Review.md\", \"document_metadata\": {\"document_id\": \"ee935bb08a9911f197db2303d7337e37\", \"name\": \"med-synth/documentation/sources/2026-08-21-License-Compliance-Review-Review.md\", \"location\": \"med-synth/documentation/sources/2026-08-21-License-Compliance-Review-Review.md\", \"type\": \"doc\", \"size\": 1278, \"chunk_count\": 2, \"create_date\": \"2026-07-28T23:35:16\", \"update_date\": \"2026-07-31T20:06:03\", \"token_count\": 583, \"thumbnail\": \"\", \"dataset_id\": \"918880948a9911f197db2303d7337e37\", \"meta_fields\": {\"path\": \"sources\"}}}], \"pagination\": {\"page\": 1, \"page_size\": 10, \"total_chunks\": 70, \"total_pages\": 7}, \"query_info\": {\"question\": \"SRC-CU-CIPH-26 audit trail logging done then reopened schema mismatch\", \"similarity_threshold\": 0.2, \"vector_weight\": 0.3, \"keyword_search\": false, \"dataset_count\": 1}}"}],"structured_content":null},"error":null,"status":"completed"}}
