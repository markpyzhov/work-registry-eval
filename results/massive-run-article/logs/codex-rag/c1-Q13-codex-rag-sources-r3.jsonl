onfirm for t025 written up today ocr fallback leaf temporari file on disk those file must not surviv after a fail page or after a success complet result complet secur delet of ephemer ocr temp is confirm for the path cover by this check this report doe not rais a separ open reman find beyond that confirm\", \"dataset_id\": \"d13efb7c8a9a11f197db2303d7337e37\", \"doc_type_kwd\": \"text\", \"document_id\": \"e999e4488a9a11f197db2303d7337e37\", \"document_keyword\": \"med-synth/documentation/sources/2026-08-20-Ephemeral-File-Cleanup-Audit-Report.md\", \"id\": \"f3e81d2903f541fe\", \"image_id\": \"\", \"important_keywords\": [], \"mom_id\": \"\", \"positions\": [], \"row_id\": null, \"similarity\": 0.2852489164534483, \"tag_kwd\": [], \"term_similarity\": 0.06349432350492616, \"vector_similarity\": 0.8026763, \"dataset_name\": \"C1Raw-2\", \"document_name\": \"med-synth/documentation/sources/2026-08-20-Ephemeral-File-Cleanup-Audit-Report.md\", \"document_metadata\": {\"document_id\": \"e999e4488a9a11f197db2303d7337e37\", \"name\": \"med-synth/documentation/sources/2026-08-20-Ephemeral-File-Cleanup-Audit-Report.md\", \"location\": \"med-synth/documentation/sources/2026-08-20-Ephemeral-File-Cleanup-Audit-Report.md\", \"type\": \"doc\", \"size\": 832, \"chunk_count\": 1, \"create_date\": \"2026-07-28T23:42:17\", \"update_date\": \"2026-07-31T20:02:00\", \"token_count\": 305, \"thumbnail\": \"\", \"dataset_id\": \"d13efb7c8a9a11f197db2303d7337e37\", \"meta_fields\": {\"path\": \"sources\"}}}], \"pagination\": {\"page\": 1, \"page_size\": 10, \"total_chunks\": 70, \"total_pages\": 7}, \"query_info\": {\"question\": \"2026-09-22 audit OCR fail closed crash reporting temporary cleanup low confidence manual review unfinished items CIPH\", \"similarity_threshold\": 0.2, \"vector_weight\": 0.3, \"keyword_search\": false, \"dataset_count\": 1}}"}],"structured_content":null},"error":null,"status":"completed"}}
