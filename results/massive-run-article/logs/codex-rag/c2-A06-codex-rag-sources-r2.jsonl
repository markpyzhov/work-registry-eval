cation\": \"opentelemetry/milestones/milestone-13661613.md\", \"type\": \"doc\", \"size\": 364, \"chunk_count\": 1, \"create_date\": \"2026-07-28T23:53:51\", \"update_date\": \"2026-07-31T20:09:49\", \"token_count\": 140, \"thumbnail\": \"\", \"dataset_id\": \"74f29ea88a9c11f197db2303d7337e37\", \"meta_fields\": {\"path\": \"sources\"}}}, {\"content\": \"**dashpole** — COMMENTED — 2025-11-12T14:59:04Z\\n\\n**MrAlias** — APPROVED — 2025-12-04T17:44:24Z\\n\\n**dmathieu** — APPROVED — 2025-12-09T14:41:46Z\\n\\n**dashpole** — COMMENTED — 2025-12-09T16:07:17Z\\n\\n**Source ID**: [SRC-PR-06]\\n\\n# Pull Request: Use sync.Map and atomics for fixed bucket histograms (open-telemetry/opentelemetry-go#7474)\\n\\n**Canonical URL**: https://github.com/open-telemetry/opentelemetry-go/pull/7474  \\n\\n**Author**: dashpole  \\n\\n**Created**: 2025-10-08T14:31:21Z · **Updated**: 2025-12-11T16:56:31Z  \\n\\n**Collected**: 2026-07-14T14:35:41Z  \\n\\n**State**: merged (2025-12-11T16:56:04Z)  \\n\\n**Branch**: `optimize_syncmap_histogram` → `main`  \\n\\n**Changes**: +560 / -201 across 7 files  \\n\\n**Labels**: —  \\n\\n**Milestone**: v1.40.0\\n\\n---\\n\\n## Review Comments (44)\\n\\n**MrAlias** on `sdk/metric/internal/aggregate/atomic.go` — 2025-10-08T22:16:25Z\\n\\nThere are data-races here because these are all stored as 3 separate fields.\\n\\nWhat about something like this instead?\\n\\n```go\\n\\n// extrema holds the minimum and maximum of a set of values.\\n\\ntype extrema[N int64 | float64] struct {\\n\\n\\tmin, max N\\n\\n\\tset      bool\\n\\n}\\n\\nfunc newExtrema[N int64 | float64](minimum, maximum N) extrema[N] {\\n\\n\\treturn extrema[N]{min: minimum, max: maximum, set: true}\\n\\n}\\n\\n// update updates the extrema with the provided value.\\n\\n//\\n\\n// If the current extrema already contains a minimum less than or equal to val,\\n\\n// no update to minimum is made.\\n\\n//\\n\\n// If the current extrema already contains a maximum greater than or equal to\\n\\n// val, no update to maximum is made.\\n\\nfunc (e extrema[N]) update(val N) extrema[N] {\\n\\n\\tif !e.set {\\n\\n\\t\\te.min = val\\n\\n\\t\\te.max = val\\n\", \"content_ltks\": \"dashpol comment 2025 11 12t14 59 04z mralia approv 2025 12 04t17 44 24z dmathieu approv 2025 12 09t14 41 46z dashpol comment 2025 12 09t16 07 17z sourc id src pr 06 pull request use sync map and atom for fix bucket histogram open telemetri opentelemetri go 7474 canon url http github com open telemetri opentelemetri go pull 7474 author dashpol creat 2025 10 08t14 31 21z updat 2025 12 11t16 56 31z collect 2026 07 14t14 35 41z state merg 2025 12 11t16 56 04z branch optim _ syncmap _ histogram main chang 560 201 across 7 file label mileston v1 400 review comment 44 mralia on sdk metric intern aggreg atom go 2025 10 08t22 16 25z there are data race here becaus these are all store a 3 separ field what about someth like this instead go extremum hold the minimum and maximum of a set of valu type extremum n int64 float64 struct min max n set bool func newextrema n int64 float64 minimum maximum n extremum n return extremum n min minimum max maximum set true updat updat the extremum with the provid valu if the current extremum alreadi contain a minimum less than or equal to val no updat to minimum is made if the current extremum alreadi contain a maximum greater than or equal to val no updat to maximum is made func e extremum n updat val n extremum n if e set e min val e max val\", \"dataset_id\": \"74f29ea88a9c11f197db2303d7337e37\", \"doc_type_kwd\": \"text\", \"document_id\": \"875d9f208a9c11f197db2303d7337e37\", \"document_keyword\": \"opentelemetry/pulls/opentelemetry-go-7474.md\", \"id\": \"a3246858fc4bc1e2\", \"image_id\": \"\", \"important_keywords\": [], \"mom_id\": \"\", \"positions\": [], \"row_id\": null, \"similarity\": 0.3706685904126752, \"tag_kwd\": [], \"term_similarity\": 0.2556118148752503, \"vector_similarity\": 0.6391344, \"dataset_name\": \"C2Raw-2\", \"document_name\": \"opentelem