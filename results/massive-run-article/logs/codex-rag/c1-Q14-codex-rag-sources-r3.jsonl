 yet 2026 08 15 09 58 charli a coupl but neither one cover everyth the old librari did still unresolv a of today go to keep look rather than forc a bad fit 2026 08 15 10 22 alic let me know a soon a one of those candid look viabl don t want this drag past the rest of the releas work\", \"dataset_id\": \"d13efb7c8a9a11f197db2303d7337e37\", \"doc_type_kwd\": \"text\", \"document_id\": \"e8f4f0468a9a11f197db2303d7337e37\", \"document_keyword\": \"med-synth/communication/sources/slack/2026-08-11-license-parser-swap.md\", \"id\": \"2536eeff413cf064\", \"image_id\": \"\", \"important_keywords\": [], \"mom_id\": \"\", \"positions\": [], \"row_id\": null, \"similarity\": 0.22130017115031678, \"tag_kwd\": [], \"term_similarity\": 0.030664473071881106, \"vector_similarity\": 0.6661168, \"dataset_name\": \"C1Raw-2\", \"document_name\": \"med-synth/communication/sources/slack/2026-08-11-license-parser-swap.md\", \"document_metadata\": {\"document_id\": \"e8f4f0468a9a11f197db2303d7337e37\", \"name\": \"med-synth/communication/sources/slack/2026-08-11-license-parser-swap.md\", \"location\": \"med-synth/communication/sources/slack/2026-08-11-license-parser-swap.md\", \"type\": \"doc\", \"size\": 1186, \"chunk_count\": 1, \"create_date\": \"2026-07-28T23:42:16\", \"update_date\": \"2026-07-31T20:04:17\", \"token_count\": 352, \"thumbnail\": \"\", \"dataset_id\": \"d13efb7c8a9a11f197db2303d7337e37\", \"meta_fields\": {\"path\": \"sources\"}}}], \"pagination\": {\"page\": 1, \"page_size\": 10, \"total_chunks\": 65, \"total_pages\": 7}, \"query_info\": {\"question\": \"\\\"calendar\\\" \\\"v1.0\\\" release go-live milestone contractual deadline fixed shipping exception\", \"similarity_threshold\": 0.2, \"vector_weight\": 0.3, \"keyword_search\": false, \"dataset_count\": 1}}"}],"structured_content":null},"error":null,"status":"completed"}}
