a document key doc 2049 last updat 2026 09 10 current status block t036 is block on that upstream librari issu local coordin work remain depend on t023 s overlay path but can not clear the gate until upstream scale is correct or an accept local remedi is chosen status block on upstream render librari scale math\", \"dataset_id\": \"d13efb7c8a9a11f197db2303d7337e37\", \"doc_type_kwd\": \"text\", \"document_id\": \"e9c0f8ee8a9a11f197db2303d7337e37\", \"document_keyword\": \"med-synth/documentation/sources/2026-09-10-High-DPI-PDF-Rendering-Coordinates-Report.md\", \"id\": \"e9d46560d0ce6c2f\", \"image_id\": \"\", \"important_keywords\": [], \"mom_id\": \"\", \"positions\": [], \"row_id\": null, \"similarity\": 0.274376281680911, \"tag_kwd\": [], \"term_similarity\": 0.09419443097273003, \"vector_similarity\": 0.6948006, \"dataset_name\": \"C1Raw-2\", \"document_name\": \"med-synth/documentation/sources/2026-09-10-High-DPI-PDF-Rendering-Coordinates-Report.md\", \"document_metadata\": {\"document_id\": \"e9c0f8ee8a9a11f197db2303d7337e37\", \"name\": \"med-synth/documentation/sources/2026-09-10-High-DPI-PDF-Rendering-Coordinates-Report.md\", \"location\": \"med-synth/documentation/sources/2026-09-10-High-DPI-PDF-Rendering-Coordinates-Report.md\", \"type\": \"doc\", \"size\": 808, \"chunk_count\": 1, \"create_date\": \"2026-07-28T23:42:17\", \"update_date\": \"2026-07-31T20:01:25\", \"token_count\": 306, \"thumbnail\": \"\", \"dataset_id\": \"d13efb7c8a9a11f197db2303d7337e37\", \"meta_fields\": {\"path\": \"sources\"}}}], \"pagination\": {\"page\": 1, \"page_size\": 10, \"total_chunks\": 70, \"total_pages\": 7}, \"query_info\": {\"question\": \"As of 2026-09-22 several streams remain blocked while others are only reopened. What work can advance in parallel, what cannot progress until an external dependency moves, and what release checklist work is gated on packaging and Windows signing?\", \"similarity_threshold\": 0.2, \"vector_weight\": 0.3, \"keyword_search\": false, \"