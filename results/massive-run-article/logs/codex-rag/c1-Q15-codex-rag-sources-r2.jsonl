irm it actual stop write at the configur quota evan i ll wait on diana s halt sign off befor call quota monitor done\", \"dataset_id\": \"d13efb7c8a9a11f197db2303d7337e37\", \"doc_type_kwd\": \"text\", \"document_id\": \"e94820e08a9a11f197db2303d7337e37\", \"document_keyword\": \"med-synth/communication/sources/fireflies/2026-08-05-Weekly-Sync.md\", \"id\": \"0d85de036037cfcd\", \"image_id\": \"\", \"important_keywords\": [], \"mom_id\": \"\", \"positions\": [], \"row_id\": null, \"similarity\": 0.2405064522783017, \"tag_kwd\": [], \"term_similarity\": 0.03463494611185953, \"vector_similarity\": 0.7208733, \"dataset_name\": \"C1Raw-2\", \"document_name\": \"med-synth/communication/sources/fireflies/2026-08-05-Weekly-Sync.md\", \"document_metadata\": {\"document_id\": \"e94820e08a9a11f197db2303d7337e37\", \"name\": \"med-synth/communication/sources/fireflies/2026-08-05-Weekly-Sync.md\", \"location\": \"med-synth/communication/sources/fireflies/2026-08-05-Weekly-Sync.md\", \"type\": \"doc\", \"size\": 1273, \"chunk_count\": 1, \"create_date\": \"2026-07-28T23:42:16\", \"update_date\": \"2026-07-31T20:03:13\", \"token_count\": 368, \"thumbnail\": \"\", \"dataset_id\": \"d13efb7c8a9a11f197db2303d7337e37\", \"meta_fields\": {\"path\": \"sources\"}}}], \"pagination\": {\"page\": 1, \"page_size\": 10, \"total_chunks\": 70, \"total_pages\": 7}, \"query_info\": {\"question\": \"CIPH-34 final project snapshot field sign-off high-latency timeout budget constraint planning exact seconds\", \"similarity_threshold\": 0.2, \"vector_weight\": 0.3, \"keyword_search\": false, \"dataset_count\": 1}}"}],"structured_content":null},"error":null,"status":"completed"}}
